{
	// 每个任务都走 ./build.sh 而不是直接调 cmake,这是本文件的要点。两个理由:
	//
	//   1. cmake 在满是 warning 的构建上照样退出 0,所以一个"绿色"的任务对 -Wall 输出
	//      什么都没说明。build.sh 出现 warning 即失败,并报告镜像开销。一个构建标准比
	//      命令行更松的按钮,就是一个隐藏回归的按钮。
	//
	//   2. BUILD_TYPE 只在 configure 时被读取。这些任务曾经把 -DCMAKE_BUILD_TYPE=Debug
	//      传进 build.sh 配成 RelWithDebInfo 的同一个 build/,于是谁先跑谁定型,另一边
	//      静默沿用 —— 表现是 text 差 70 KB,读起来像代码膨胀。一个入口,一种配置。
	//
	// build.sh 自己按需 configure、自己挑 -j、并执行门禁,所以这些条目故意很薄。
	// 不要在这里重新引入 cmake 调用:让按钮和终端走同一条路径。
	"version": "2.0.0",
	"tasks": [
		{
			// 增量。warning 只对真正重编译过的文件出现,所以无改动时它报 UP TO DATE
			// 而不是"0 warnings" —— 要零 warning 的证据请用 rebuild task。
			"label": "build task",
			"type": "shell",
			"command": "./build.sh",
			"problemMatcher": "$gcc",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			// 全量重建:先删 build/,所以只有这一次的"0 warnings"是有意义的。也是唯一
			// 能改变 BUILD_TYPE 的途径,因为已存在的 cache 会盖过环境变量。
			"label": "rebuild task",
			"type": "shell",
			"command": "./build.sh clean",
			"problemMatcher": "$gcc",
			"group": {
				"kind": "none",
				"isDefault": false
			}
		},
		{
			// 烧写前先构建并过门禁,所以不会烧进一个过期的或带 warning 的镜像。
			"label": "download dap",
			"type": "shell",
			"command": "./build.sh flash",
			"problemMatcher": [],
			"group": {
				"kind": "none",
				"isDefault": false
			}
		},
		{
			// 烧写,然后在 tcp/9090 上服务 RTT 日志直到中断。RTT 是本固件唯一的日志
			// 通路(走 SWD,不经 UART),所以 bring-up 阶段任何东西要说话都靠它。
			// 另开终端读: nc localhost 9090
			"label": "rtt log",
			"type": "shell",
			"command": "./build.sh rtt",
			"problemMatcher": [],
			"group": {
				"kind": "none",
				"isDefault": false
			}
		}
	]
}
