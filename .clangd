# clangd configuration for this STM32H723 firmware project.
#
# The flags themselves are NOT here. They come from compile_commands.json, which
# CMake writes on every configure (CMAKE_EXPORT_COMPILE_COMMANDS in the root
# CMakeLists) — so clangd sees exactly what the compiler sees, and a source or
# include path added to the build cannot leave this file behind. Nothing needs
# running by hand; the database lands in build/, and .vscode/settings.json passes
# --compile-commands-dir=build so clangd finds it there.
#
# clangd does not read .vscode/c_cpp_properties.json; that file is for the
# Microsoft C/C++ extension, whose IntelliSense is disabled in settings.json.
#
# What remains here is the handful of things a compile database cannot express.

# There are deliberately NO absolute paths in this file, so a clone needs no edit
# here. Two settings that used to be below were removed on 2026/9/4 after being
# measured as having no effect:
#
#   Compiler: <abs path to arm-none-eabi-gcc>
#   - -isystem<abs path>/arm-none-eabi/include
#
# Both are already supplied by compile_commands.json, which CMake regenerates on
# whatever machine configures the build, so its compiler path is correct there by
# construction. --query-driver (see .vscode/settings.json) then has clangd run
# that compiler for its target, builtin macros and system header directories --
# newlib's include directory among them, which is what the -isystem line was
# added for.
#
# Verified rather than assumed: `clangd --check` over 40 project sources gives
# byte-identical results with and without those two lines (the same 12 failures
# either way, all of them stm32f4 backends that this board does not build). The
# file that originally motivated the -isystem line, 04_impl/rtos/freertos/
# rtos_hooks.c, reports 0 errors without it.
#
# Do NOT add them back to "fix" unresolved cross-compiled headers. That symptom
# is ARM_TOOLCHAIN_BIN being unset, which makes --query-driver expand to a
# pattern matching nothing -- clangd then reports every toolchain header as
# missing without saying why, while the build stays clean. See README 1.1.

CompileFlags:
  Add:
    # A bare .h is ambiguous — C, C++ and Objective-C all use it — and clangd
    # guesses Objective-C++ for headers with no matching .c in the database.
    # Forcing C is what makes the *_ops contracts and util_* headers navigable.
    - -xc

  Remove:
    # Valid for arm-none-eabi-gcc, rejected by clangd's bundled clang. Each one
    # left in place aborts parsing for the whole translation unit, which shows up
    # as "every symbol is unknown" rather than as one bad-flag message.
    # CMake does not emit these, but a hand-run compiler invocation might; this is
    # the backstop for a
    # database generated some other way (bear, compiledb, an IDE).
    - -mword-relocations
    - -fno-tree-scev-cprop
    - -Wa,*
    - -specs=*
    - -flto*
    - --param*

Diagnostics:
  Suppress:
    # The vendor tree is generated code we do not edit, and its warnings would
    # bury the ones from code we do. Project sources are still fully checked —
    # the build runs -Wall and is kept at zero warnings.
    - unused-includes

  UnusedIncludes: None
